<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permitted cleartext for local and on-premise development across all subnets -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext permitted ONLY for private local networks for offline/on-premise deployments -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">172.16.0.160</domain>
        <domain includeSubdomains="true">172.16.0.133</domain>
        <domain includeSubdomains="true">192.168.100.181</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
    </domain-config>
</network-security-config>
