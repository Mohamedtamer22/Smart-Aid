# Copy to .env for native local development. Never commit the real file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartaid
DB_USERNAME=smartaid_user
DB_PASSWORD=replace-with-a-long-unique-database-password
JWT_SECRET=replace-with-a-base64-or-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
BACKEND_PORT=8080
# Optional absolute JDK path used by the helper scripts. The backend requires Java 21+.
SMARTAID_JAVA_HOME=
# Opt-in only: creates fictional local accounts and simulated incidents for a presentation.
SMARTAID_DEMO_SEED=false
# Needed only when running the local API on Java 25 for Windows selector compatibility.
SMARTAID_TOMCAT_NIO2=false
MAP_API_KEY=change_me
NOTIFICATION_API_KEY=change_me
AI_API_KEY=change_me
